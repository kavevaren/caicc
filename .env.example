# Orvina environment — variables from SPEC §4.1 only.
# Copy to .env for local dev; in the Studio, set these in the Studio Secrets /
# Variables panel. Never put real values in code, docs, prompts, logs or tests.

# ModelScope API token (required). Get it at https://modelscope.ai/my/access/token
MODELSCOPE_TOKEN=

# Random 32-byte hex key (required). Used for AES-GCM (Google tokens) and sessions.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=

# Shared data directory: /data if writable, else /tmp/orvina (default).
#DATA_DIR=/tmp/orvina

# Port the server listens on (default 7860; must match ms_deploy.json and EXPOSE).
#PORT=7860

# Public URL of the deployed app (OAuth redirect, "Buka di tab baru").
#PUBLIC_APP_URL=https://your-studio-url

# Google Calendar OAuth (F3; without these the app runs in local mode).
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# Speech-to-text (SPEC §2.3: every feature must work with this off).
#ENABLE_TRANSCRIPTION=true
#WHISPER_MODEL=base
#WHISPER_PRELOAD=false
#MAX_MEDIA_MINUTES=15

# Uploads and jobs (lower MAX_UPLOAD_MB if the Studio proxy accepts less; see P0 report).
#MAX_UPLOAD_MB=200
#JOB_WORKERS=2

# P0 only: model used by the health probe (default: the FAST model).
# The platform can drop a model at any time — if the probe shows unreachable,
# set this to an allowed model that is currently up (see docs/PROGRESS.md).
#PROBE_MODEL=
